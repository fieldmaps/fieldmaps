---
import Logo from "../components/Logo.astro";
import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: boolean;
}
---

<Base {...Astro.props}>
  <header class="site-header">
    <nav class="wrap">
      <a class="brand" href="/">
        <Logo size={36} alt="" />
        <span>FieldMaps</span>
      </a>
      <a href="/international/">International</a>
      <a href="/subnational/">Subnational</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
</Base>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--white);
    border-bottom: 3px solid var(--paper);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    font-size: 1.2rem;
    font-weight: 700;
  }
</style>
