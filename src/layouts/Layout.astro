---
import Logo from "../components/Logo.astro";
import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: boolean;
}

const links = [
  { label: "International", href: "/international/" },
  { label: "Subnational", href: "/subnational/" },
  { label: "Explore", href: "/explore/" },
];
const path = Astro.url.pathname;
const current = links.find((link) => path.startsWith(link.href));
---

<Base {...Astro.props}>
  <header class="site-header">
    <nav class="wrap">
      <a class="brand" href="/">
        <Logo size={36} />
        <span>FieldMaps</span>
      </a>
      {links.map((link) => (
        <a href={link.href} aria-current={link === current ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </header>
  <main>
    <slot />
  </main>
</Base>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--white);
    border-bottom: 3px solid var(--paper);
  }
  nav {
    display: flex;
    align-items: stretch;
    gap: 1.5rem;
    min-height: 4rem;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
  }
  nav a:not(.brand) {
    display: flex;
    align-items: center;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
  }
  nav a[aria-current="page"] {
    font-weight: 700;
    border-bottom-color: var(--ink);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    font-size: 1.2rem;
    font-weight: 700;
  }
  @media (max-width: 480px) {
    .brand span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
