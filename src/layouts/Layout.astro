---
import Logo from "../components/Logo.astro";
import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: boolean;
}

const menus = [
  {
    label: "International",
    items: [
      { label: "Overview", href: "/international/" },
      { label: "Compare", href: "/international/compare/" },
      { label: "Download", href: "https://source.coop/fieldmaps/international" },
    ],
  },
  {
    label: "Subnational",
    items: [
      { label: "Overview", href: "/subnational/" },
      { label: "Download", href: "https://source.coop/fieldmaps/subnational" },
    ],
  },
];
const path = Astro.url.pathname;
---

<Base {...Astro.props}>
  <header class="site-header">
    <nav class="wrap">
      <a class="brand" href="/">
        <Logo size={36} />
        <span>FieldMaps</span>
      </a>
      {menus.map((menu) => (
        <details class="menu" name="site-menu">
          <summary>{menu.label}</summary>
          <ul>
            {menu.items.map((item) => (
              <li>
                <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </nav>
  </header>
  <main>
    <slot />
  </main>
</Base>

<script>
  const menus = [...document.querySelectorAll<HTMLDetailsElement>(".menu")];
  const close = () => menus.forEach((m) => (m.open = false));
  document.addEventListener("click", (e) => {
    if (!menus.some((m) => m.contains(e.target as Node))) close();
  });
  document.addEventListener("keydown", (e) => e.key === "Escape" && close());
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--white);
    border-bottom: 3px solid var(--paper);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
  }
  .menu {
    position: relative;
  }
  summary {
    cursor: pointer;
    list-style-position: outside;
  }
  summary::marker {
    content: "";
  }
  summary::after {
    content: "▾";
    margin-left: 0.35rem;
    font-size: 0.8em;
  }
  ul {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 10rem;
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--paper);
  }
  ul a {
    display: block;
    padding: 0.4rem 1rem;
  }
  ul a:hover,
  ul a[aria-current="page"] {
    background: var(--paper-light);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    font-size: 1.2rem;
    font-weight: 700;
  }
</style>
