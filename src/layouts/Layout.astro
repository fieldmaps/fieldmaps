---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Global administrative boundaries for humanitarian use." } =
  Astro.props;
const pageTitle = title === "FieldMaps" ? title : `${title} | FieldMaps`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/img/logo-192.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">FieldMaps</a>
        <a href="/international/">International</a>
        <a href="/subnational/">Subnational</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
